# Nachuan source-development example. Never place real credentials in Git.
# `nachuan start` generates and protects local owner credentials automatically;
# leave the key fields blank unless you are deliberately using the advanced
# bare-engine path.

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_API_KEYS=
APPROVAL_ADMIN_KEY=
NACHUAN_PAID_MEDIA_API_KEY=
BRIDGE_API_KEY=
NACHUAN_WEIXIN_BRIDGE_API_KEY=
NACHUAN_FEISHU_BRIDGE_API_KEY=

# Optional provider/API connections. Prefer the Connection Center, which stores
# verified credentials in the platform-protected local store.
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Optional channels. Empty identities and secrets keep the channel disabled.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_USERS=
FEISHU_OWNER_OPEN_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
BRIDGE_ENGINE_URL=http://127.0.0.1:8080
BRIDGE_MODEL=agnes-flash

# Local runtime data. Relative paths are anchored to the project root.
USAGE_DB_PATH=./data/usage.db
BACKUP_DIR=
AGENT_EXEC_WORKDIR=

# Production keeps model/runtime downloads disabled unless an exact source,
# immutable revision, license, size, and SHA-256 have been reviewed.
NACHUAN_ENABLE_VERIFIED_MODEL_DOWNLOAD=0
NACHUAN_EMBED_DISABLED=1
