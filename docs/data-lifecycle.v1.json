{
  "schema": "nachuan.data-lifecycle.v1",
  "version": 1,
  "status": "engineering-baseline-not-legal-certification",
  "last_verified": "2026-07-18",
  "official_sources": [
    {
      "authority": "Cyberspace Administration of China",
      "title": "Personal Information Protection Law of the People's Republic of China",
      "url": "https://www.cac.gov.cn/2021-08/20/c_1631050028355286.htm",
      "accessed": "2026-07-18",
      "applies_to": "purpose limitation, shortest necessary retention, access/copy/correction/deletion, processors, impact assessment and breach response"
    },
    {
      "authority": "EUR-Lex",
      "title": "Regulation (EU) 2016/679 (GDPR)",
      "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng",
      "accessed": "2026-07-18",
      "applies_to": "access, erasure, portability, processor contracts and breach notification where EU law applies"
    },
    {
      "authority": "NIST",
      "title": "SP 800-61 Rev. 3 Incident Response Recommendations and Considerations for Cybersecurity Risk Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/61/r3/final",
      "accessed": "2026-07-18",
      "applies_to": "prepare, detect, respond, recover and improve incident-response operations"
    }
  ],
  "defaults": {
    "customer_data_used_for_training": false,
    "raw_data_in_support_bundle": false,
    "retention_rule": "shortest-necessary-configurable-by-deployment-and-contract",
    "deletion_transaction": "durable-idempotent-saga-with-per-store-receipts",
    "backup_restore_rule": "restore-locked-until-all-applicable-deletion-tombstones-are-reapplied",
    "legal_hold_rule": "retain-minimum-required-copy-and-block-all-unrelated-processing",
    "provider_disclosure_rule": "show-destination-purpose-data-classes-and-retention-before-enabling-egress"
  },
  "rights_workflow": {
    "identity_verification": "deployment-owner-controlled-and-proportionate",
    "states": [
      "received",
      "identity_pending",
      "scoped",
      "executing",
      "partially_completed",
      "completed",
      "rejected_with_reason"
    ],
    "export_format": "versioned-machine-readable-json-plus-content-addressed-attachments",
    "deletion_behavior": "erase-or-tombstone-where-authorized; retain-and-restrict-only-where-required",
    "recipient_followup": "record-each-configured-processor-or-destination-notification-result",
    "deadline": "jurisdiction-and-contract-defined-never-hardcoded-as-universal"
  },
  "incident_response": {
    "framework": "NIST-SP-800-61r3-CSF-2.0-profile",
    "clock_start": "first-supported-awareness-not-ticket-creation-time",
    "evidence_rule": "preserve-minimum-redacted-timeline-hashes-and-authority-receipts-without-copying-customer-content",
    "notification_rule": "jurisdiction-role-risk-and-contract-driven-with-legal-owner-review",
    "credential_rule": "revoke-or-rotate-at-the-upstream-before-local-secret-deletion-is-called-complete"
  },
  "stores": [
    {
      "id": "conversations_and_summaries",
      "category": "customer-content",
      "locations": ["data/conversations.db", "data/conv_summary.db"],
      "data": ["user messages", "assistant messages", "served model identity", "token usage", "conversation summaries"],
      "purpose": "deliver and resume conversations",
      "export_policy": "include_machine_readable",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "tenant-configurable-shortest-necessary",
      "processors": ["local-engine", "configured-model-provider-when-a-turn-is-sent"],
      "customer_training": false,
      "restore_policy": "reapply-deletion-tombstone-before-readiness",
      "incident_tier": "critical"
    },
    {
      "id": "knowledge_memory_and_cases",
      "category": "customer-content",
      "locations": ["data/knowledge.db", "data/memory.db", "data/cases.db", "data/scoreboard.db"],
      "data": ["imported documents", "chunks and embeddings", "long-term memory", "case library", "evaluation feedback"],
      "purpose": "retrieval, continuity and user-requested learning",
      "export_policy": "include_machine_readable",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "tenant-configurable-shortest-necessary",
      "processors": ["local-engine", "configured-embedding-provider-only-when-explicitly-enabled"],
      "customer_training": false,
      "restore_policy": "reapply-deletion-tombstone-before-index-rebuild",
      "incident_tier": "critical"
    },
    {
      "id": "task_ledger_and_workspaces",
      "category": "customer-content",
      "locations": ["data/ledger.db", "workspaces/**", "**/.纳川/画布.json", "**/任务.json"],
      "data": ["task plans", "workspace files", "step receipts", "long-task checkpoints"],
      "purpose": "execute and resume approved tasks",
      "export_policy": "include_machine_readable",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "project-or-tenant-controlled",
      "processors": ["local-engine", "restricted-worker-when-enabled"],
      "customer_training": false,
      "restore_policy": "reapply-project-deletion-before-agent-resume",
      "incident_tier": "critical"
    },
    {
      "id": "workflow_execution_event_truth",
      "category": "security-and-operational",
      "locations": ["data/workflow-events.db"],
      "data": ["workflow and event identifiers", "turn step and model phases", "model route metadata", "input and result byte hashes and lengths", "append-only chain hashes and timestamps"],
      "purpose": "reconstruct plugin workflow execution topology and detect event-history tampering without copying customer text",
      "export_policy": "include_metadata_only",
      "delete_policy": "retain_and_restrict",
      "retention_rule": "bounded-200000-event-and-256MiB-log-capacity-pending-deployment-archive-policy",
      "processors": ["local-engine"],
      "customer_training": false,
      "restore_policy": "restore-only-a-verified-complete-hash-chain-and-never-merge-unrelated-installation-history",
      "incident_tier": "high"
    },
    {
      "id": "connections_and_provider_credentials",
      "category": "credentials",
      "locations": ["data/connections.json", "userData/config.json"],
      "data": ["provider API keys", "base URLs", "encrypted desktop engine keys", "connection validation state"],
      "purpose": "connect customer-selected model providers",
      "export_policy": "exclude_secret",
      "delete_policy": "revoke_then_erase",
      "retention_rule": "until-connection-removal-or-credential-rotation",
      "processors": ["local-main", "local-engine", "selected-provider"],
      "customer_training": false,
      "restore_policy": "never-reactivate-revoked-credentials-from-backup",
      "incident_tier": "critical"
    },
    {
      "id": "channel_credentials_and_access",
      "category": "credentials",
      "locations": ["data/ilink_token.json", "data/weixin_access.json", "data/feishu_access.json", "data/sync.json"],
      "data": ["channel tokens", "owner allowlists", "cloud sync credentials"],
      "purpose": "operate explicitly enabled channels and sync",
      "export_policy": "exclude_secret",
      "delete_policy": "revoke_then_erase",
      "retention_rule": "until-channel-disable-or-credential-rotation",
      "processors": ["local-channel-service", "selected-channel-or-sync-provider"],
      "customer_training": false,
      "restore_policy": "never-reactivate-revoked-credentials-from-backup",
      "incident_tier": "critical"
    },
    {
      "id": "channel_delivery_and_idempotency",
      "category": "customer-content",
      "locations": ["data/weixin_outbox.db", "data/weixin_agent_idempotency.db", "data/feishu_bridge.db", "data/bridge_protocol_replay.db"],
      "data": ["inbound and outbound delivery payloads", "delivery state", "idempotency keys", "dead-letter state"],
      "purpose": "ordered durable delivery and replay protection",
      "export_policy": "include_machine_readable",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "bounded-terminal-retention-configured-by-channel",
      "processors": ["local-channel-service", "selected-channel-provider"],
      "customer_training": false,
      "restore_policy": "reapply-deletion-and-delivery-tombstones-before-send",
      "incident_tier": "critical"
    },
    {
      "id": "usage_billing_and_provider_calls",
      "category": "financial-and-operational",
      "locations": ["data/usage.db", "data/provider-calls.db"],
      "data": ["provider attempts", "served model", "token and media units", "cost quotes", "holds", "captures", "refund and reconciliation state"],
      "purpose": "budget enforcement, customer billing, dispute handling and reconciliation",
      "export_policy": "include_machine_readable",
      "delete_policy": "retain_and_restrict",
      "retention_rule": "contract-tax-accounting-and-dispute-requirements-by-deployment",
      "processors": ["local-engine", "billing-operator-when-commercial-mode-is-enabled"],
      "customer_training": false,
      "restore_policy": "preserve-ledger-identity-and-reapply-access-restrictions",
      "incident_tier": "critical"
    },
    {
      "id": "approvals_admission_and_undo",
      "category": "security-and-operational",
      "locations": ["data/approvals.db", "data/admission.db", "data/undo_receipts.db", "data/undo-signing-key.protected.json"],
      "data": ["approval decisions", "capability expiry", "rate-limit state", "undo evidence"],
      "purpose": "authorize high-risk actions and recover workspace changes",
      "export_policy": "include_metadata_only",
      "delete_policy": "retain_and_restrict",
      "retention_rule": "bounded-security-and-dispute-window",
      "processors": ["local-engine"],
      "customer_training": false,
      "restore_policy": "preserve-replay-fences-and-never-reopen-expired-capabilities",
      "incident_tier": "high"
    },
    {
      "id": "privacy_rights_requests_and_receipts",
      "category": "security-and-compliance-metadata",
      "locations": ["data/privacy_rights.db"],
      "data": ["irreversible subject digest", "request action and frozen scope", "identity evidence digest", "per-store step outcomes and evidence digests"],
      "purpose": "orchestrate access, export, restriction and deletion requests with crash-safe completion evidence",
      "export_policy": "include_metadata_only",
      "delete_policy": "retain_and_restrict",
      "retention_rule": "jurisdiction-contract-dispute-and-proof-window-by-deployment",
      "processors": ["local-engine", "authorized-privacy-operator"],
      "customer_training": false,
      "restore_policy": "preserve-terminal-receipts-and-never-reopen-completed-or-rejected-requests",
      "incident_tier": "critical"
    },
    {
      "id": "paid_media_requests_and_installation_authority",
      "category": "financial-and-security",
      "locations": ["data/paid_media_requests.db", "data/paid_media_web_operations.db", "ProgramData/StateRoot/installation-root.db", "ProgramData/StateRoot/gateway-paid-media-requests.db", "userData/data/paid-media-ledger.json", "userData/data/paid-media-capacity.json", "userData/data/paid-media-installation-authority.json"],
      "data": ["paid operation identity", "request digest", "provider phase", "capacity", "installation epoch", "anti-rollback state"],
      "purpose": "prevent duplicate paid side effects and coordinated rollback",
      "export_policy": "include_metadata_only",
      "delete_policy": "retire_epoch",
      "retention_rule": "financial-dispute-and-security-authority-lifecycle",
      "processors": ["local-main", "local-engine", "local-service-when-enabled"],
      "customer_training": false,
      "restore_policy": "manual-reanchor-into-new-epoch-with-old-pending-operations-manual-only",
      "incident_tier": "critical"
    },
    {
      "id": "paid_media_vault_and_assets",
      "category": "customer-content",
      "locations": ["userData/data/paid-media-vault/**", "data/asset-store.db", "data/paid-media-web-archive/**"],
      "data": ["generated images and videos", "archive receipts", "validation evidence", "cleanup debt"],
      "purpose": "durable delivery and replay of paid results",
      "export_policy": "include_machine_readable",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "customer-download-window-plus-dispute-and-cleanup-requirements",
      "processors": ["local-main", "local-engine", "selected-media-provider"],
      "customer_training": false,
      "restore_policy": "reapply-deletion-before-asset-token-or-download-reenable",
      "incident_tier": "critical"
    },
    {
      "id": "media_cache_and_studio",
      "category": "customer-content",
      "locations": ["data/media_cache.json", "data/studio/**", "data/feishu_pending_videos.json"],
      "data": ["media URLs", "generated files", "studio job metadata", "pending delivery references"],
      "purpose": "media processing, preview and delivery",
      "export_policy": "include_machine_readable",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "bounded-cache-and-project-controlled-output",
      "processors": ["local-engine", "selected-media-provider", "selected-channel-provider"],
      "customer_training": false,
      "restore_policy": "reapply-deletion-before-job-resume-or-delivery",
      "incident_tier": "critical"
    },
    {
      "id": "cloud_sync_replicas",
      "category": "customer-content",
      "locations": ["configured-cloud-sync-target"],
      "data": ["memory", "cases", "knowledge documents and tombstones selected for sync"],
      "purpose": "customer-enabled cross-device sync",
      "export_policy": "customer_configurable",
      "delete_policy": "customer_managed",
      "retention_rule": "customer-contract-with-selected-sync-provider",
      "processors": ["selected-sync-provider"],
      "customer_training": false,
      "restore_policy": "target-epoch-fenced-and-deletion-tombstones-win-over-older-replicas",
      "incident_tier": "critical"
    },
    {
      "id": "logs_health_and_support_bundles",
      "category": "diagnostic-metadata",
      "locations": ["data/logs/**", "userData/logs/desktop-main.jsonl", "userData/support-bundles/nachuan-support-*.json", "data/weixin_bridge_health.json", "data/feishu_bridge_health.json"],
      "data": ["allowlisted event names", "timestamps", "status and aggregate counters", "core final-byte hashes"],
      "purpose": "availability diagnosis, incident triage and customer support",
      "export_policy": "include_metadata_only",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "bounded-rotation-and-support-case-window",
      "processors": ["local-main", "local-engine", "support-recipient-only-after-user-action"],
      "customer_training": false,
      "restore_policy": "do-not-restore-expired-support-bundles",
      "incident_tier": "high"
    },
    {
      "id": "backups_and_restore_evidence",
      "category": "mixed-encrypted-backup",
      "locations": ["data/backup/**", "user-configured-backup-target"],
      "data": ["verified database snapshots", "backup manifests", "pre-restore safety snapshots", "restore transaction evidence"],
      "purpose": "disaster recovery",
      "export_policy": "exclude_system_authority",
      "delete_policy": "expire_and_reapply_tombstones",
      "retention_rule": "bounded-backup-generations-and-customer-policy",
      "processors": ["local-engine", "customer-selected-backup-storage"],
      "customer_training": false,
      "restore_policy": "restore-locked-until-deletion-tombstones-and-installation-epoch-reanchor-complete",
      "incident_tier": "critical"
    },
    {
      "id": "update_and_installation_state",
      "category": "security-authority",
      "locations": ["ProgramData/StateRoot/installation-root.db", "userData/update-state/**", "resources/store-runtime-profile.v1.json"],
      "data": ["installation identity", "epoch", "update sequence", "accepted artifact hashes", "runtime profile hash"],
      "purpose": "secure install, update, rollback prevention and runtime closure",
      "export_policy": "include_metadata_only",
      "delete_policy": "retire_epoch",
      "retention_rule": "installation-lifetime-plus-retired-tombstone",
      "processors": ["local-main", "local-service-when-enabled", "configured-update-channel"],
      "customer_training": false,
      "restore_policy": "never-lower-floor-or-reuse-retired-epoch",
      "incident_tier": "critical"
    },
    {
      "id": "model_improvement_and_routing_data",
      "category": "evaluation-data",
      "locations": ["data/routing_dataset.jsonl", "train/**", "models/coordinator/**"],
      "data": ["routing labels", "evaluation prompts and outcomes", "frozen baselines", "candidate model artifacts"],
      "purpose": "offline evaluation and explicitly authorized model improvement",
      "export_policy": "include_metadata_only",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "dataset-version-and-provenance-controlled",
      "processors": ["offline-evaluation-runner"],
      "customer_training": false,
      "restore_policy": "never-reintroduce-revoked-or-unprovenanceable-examples",
      "incident_tier": "critical"
    },
    {
      "id": "plugins_mcp_and_tool_configuration",
      "category": "security-and-configuration",
      "locations": ["data/mcp.json", "data/mcp.active.json", "skills/trusted-manifest.json"],
      "data": ["tool server configuration", "enabled state", "trusted bundle hashes"],
      "purpose": "operate explicitly approved extensions",
      "export_policy": "include_metadata_only",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "until-extension-disable-or-uninstall",
      "processors": ["local-engine", "restricted-worker-when-enabled"],
      "customer_training": false,
      "restore_policy": "disabled-until-trust-and-profile-revalidation",
      "incident_tier": "high"
    },
    {
      "id": "semantic_cache_and_replay_fences",
      "category": "derived-and-security",
      "locations": ["data/semcache/cache.db", "data/bridge_protocol_replay.db"],
      "data": ["derived cache keys and responses", "replay nonces"],
      "purpose": "latency reduction and replay prevention",
      "export_policy": "exclude_system_authority",
      "delete_policy": "erase_or_tombstone",
      "retention_rule": "short-bounded-cache-and-replay-window",
      "processors": ["local-engine"],
      "customer_training": false,
      "restore_policy": "clear-derived-cache-and-preserve-required-replay-floor",
      "incident_tier": "high"
    }
  ]
}
